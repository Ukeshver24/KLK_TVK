generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
  MLA_OFFICE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  OFFICER_ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  OTHERS
}

model User {
  id         String      @id @default(uuid())
  userCode   String?     @unique // Unique sequential ID, e.g., TVK-C-0001
  fullName   String
  mobile     String      @unique
  dob        String?
  address    String?
  mpinHash   String
  fcmToken   String?     // Firebase Cloud Messaging Device Token for Push Notifications
  role       Role        @default(CITIZEN)
  status     UserStatus  @default(ACTIVE)
  complaints Complaint[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("users")
}

model Village {
  id        String   @id @default(uuid())
  taluk     String   @default("Kallakurichi")
  nameTa    String   // e.g. "அந்தியூர்"
  nameEn    String   // e.g. "Anthiyur"
  pincode   String?  // e.g. "606202"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taluk, nameTa])
  @@map("villages")
}

model Complaint {
  id              String          @id @default(uuid())
  referenceId     String          @unique // Exact format: TVK-KKI-26-0001
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  fullName        String
  mobile          String
  taluk           String
  village         String
  address         String
  pincode         String
  category        String
  description     String
  attachment      String?         // Multi-image proof paths
  latitude        Float?          // GPS Problem Location Latitude
  longitude       Float?          // GPS Problem Location Longitude
  locationUrl     String?         // Google Maps Link
  status          ComplaintStatus @default(SUBMITTED)
  assignedCadreId String?
  assignedCadre   Cadre?          @relation(fields: [assignedCadreId], references: [id])
  adminRemarks    String?
  statusReason    String?
  timelineEvents  Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("complaints")
}

model Cadre {
  id          String      @id @default(uuid())
  cadreCode   String?     @unique // e.g. TVK-CAD-001
  name        String
  nameTa      String?
  phone       String      @unique
  role        String
  roleTa      String?
  taluk       String      @default("Kallakurichi")
  talukTa     String?
  village     String
  villageTa   String?
  boothNumber String
  voterId     String?
  photoUrl    String?
  isVerified  Boolean     @default(true)
  complaints  Complaint[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("cadres")
}

model Banner {
  id        String   @id @default(uuid())
  slot      Int      @unique // 1, 2, 3 (Strictly 3 banner slots)
  imageUrl  String   // File path or URL e.g. "banner-1.jpg" or "/uploads/banners/..."
  title     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model MlaContact {
  id              String   @id @default(uuid())
  name            String   @default("C. Arul Vignesh")
  degree          String   @default("M.Sc.,")
  designationEn   String   @default("MLA, KALLAKURICHI")
  designationTa   String   @default("சட்டப்பேரவை உறுப்பினர், கள்ளக்குறிச்சி")
  addressEn       String   @default("No 42, Main Road, Near Bus Stand, Kallakurichi, Tamil Nadu – 606202")
  addressTa       String   @default("எண் 42, பிரதான சாலை, பேருந்து நிலையம் அருகில், கள்ளக்குறிச்சி, தமிழ்நாடு – 606202")
  phone           String   @default("+91 98765 43210")
  email           String   @default("mla.kallakurichi@tvk.in")
  visitingHoursEn String   @default("Monday - Saturday: 09:00 AM - 06:00 PM")
  visitingHoursTa String   @default("திங்கள் - சனி: காலை 09:00 - மாலை 06:00")
  photoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mla_contacts")
}

model SystemSetting {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  maintenanceTitleEn String   @default("Under Scheduled Maintenance")
  maintenanceTitleTa String   @default("பராமரிப்பு பணியில் உள்ளது")
  maintenanceMsgEn   String   @default("We are currently upgrading our systems to serve you better. The app will be back online shortly.")
  maintenanceMsgTa   String   @default("சேவையக மேம்பாட்டு பணிகள் நடைபெற்று வருகின்றன. செயலி விரைவில் மீண்டும் பயன்பாட்டுக்கு வரும்.")
  
  // App Version & Force Update Controls
  minAppVersion      String   @default("1.0.0")
  latestAppVersion   String   @default("1.0.0")
  forceUpdate        Boolean  @default(false)
  playStoreUrl       String   @default("https://play.google.com/store/apps/details?id=com.example.tvk_application")
  appStoreUrl        String   @default("https://apps.apple.com/app/id6400000000")
  updateTitleEn      String   @default("Update Required")
  updateTitleTa      String   @default("புதிய பதிப்பு கிடைக்கிறது")
  updateMsgEn        String   @default("A new version of the app is available. Please update to continue using the app with the latest features and improvements.")
  updateMsgTa        String   @default("செயலியின் புதிய பதிப்பு கிடைக்கிறது. புதிய அம்சங்களுடன் தொடர்ந்து பயன்பாட்டிற்கு செயலியைப் புதுப்பிக்கவும்.")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("system_settings")
}

enum AlertSeverity {
  EMERGENCY
  ANNOUNCEMENT
  WEATHER
  EVENT
}

enum AlertFrequency {
  EVERY_OPEN
  ONCE_PER_DAY
}

model BroadcastAlert {
  id            String         @id @default("singleton")
  title         String         @default("கள்ளக்குறிச்சி பொதுமக்களுக்கு முக்கிய அவசர அறிவிப்பு!")
  message       String         @default("கள்ளக்குறிச்சி மற்றும் சின்னசேலம் பகுதிகளில் பெய்து வரும் கனமழை காரணமாக தாழ்வான பகுதிகளில் உள்ள பொதுமக்கள் பாதுகாப்பாக இருக்குமாறு கேட்டுக்கொள்ளப்படுகிறார்கள். ஏதேனும் அவசர உதவி தேவைப்பட்டால் உடனே நமது TVK 24x7 கட்டுப்பாட்டு அறையை தொடர்பு கொள்ளவும்.")
  severity      AlertSeverity  @default(EMERGENCY)
  imageUrl      String?
  isActive      Boolean        @default(true)
  targetScope   String         @default("Entire Kallakurichi Constituency (79)")
  showFrequency AlertFrequency @default(EVERY_OPEN)
  authorTag     String         @default("From the Desk of MLA")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("broadcast_alerts")
}

model AdminUser {
  id                String      @id @default(uuid())
  username          String      @unique
  email             String      @unique
  passwordHash      String
  fullName          String      @default("Kallakurichi MLA Office Admin")
  role              Role        @default(ADMIN)
  status            UserStatus  @default(ACTIVE)
  resetToken        String?     @unique
  resetTokenExpires DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("admin_users")
}
