# ===============================================
# TVK Grievance Portal Backend - Environment Configuration
# ===============================================

# Server Port
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/tvk_db?schema=public"

# JSON Web Token (JWT) Secrets & Expirations
# Generate a high-entropy 256-bit random string in production: openssl rand -base64 32
JWT_SECRET="tvk_production_super_secure_jwt_secret_key_2026_kallakurichi"
JWT_EXPIRES_IN="30d"
ADMIN_JWT_EXPIRES_IN="8h"

# Default Admin Seed Credentials (Used on initial database bootstrap)
ADMIN_DEFAULT_EMAIL="mla.kallakurichi@tvk.in"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProd!2026"

# Admin Web Portal URL (For password reset email redirection)
ADMIN_WEB_URL="http://localhost:5173"

# SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="TVK MLA Command Center <no-reply@tvk.in>"
